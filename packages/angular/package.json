{
  "name": "@akin2unde/flowui-angular",
  "version": "1.0.1",
  "description": "Angular components for FlowUI.",
  "author": "Akintunde Morakinyo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akin2unde/FlowUI.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/akin2unde/FlowUI#readme",
  "bugs": "https://github.com/akin2unde/FlowUI/issues",
  "keywords": [
    "flowui",
    "angular",
    "components",
    "tailwind",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/akin2unde-flowui-angular.d.ts",
      "default": "./dist/fesm2022/akin2unde-flowui-angular.mjs"
    },
    "./styles.css": "./dist/flowui.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json && cp ../styles/dist/flowui.css dist/flowui.css && node ../../scripts/finalize-angular.mjs",
    "typecheck": "tsc -p tsconfig.lib.json --noEmit",
    "prepack": "node ../../scripts/prepack.mjs angular",
    "test": "vitest run"
  },
  "dependencies": {
    "@akin2unde/flowui-core": "1.0.0",
    "tslib": "^2.8.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@fortawesome/fontawesome-free": ">=6"
  },
  "devDependencies": {
    "@angular/common": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/compiler-cli": "^22.2.5",
    "ng-packagr": "^22.2.6",
    "typescript": "~6.0.3"
  },
  "sideEffects": [
    "*.css"
  ]
}
