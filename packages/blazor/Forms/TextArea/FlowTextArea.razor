@namespace FlowUI.Blazor.Forms
@inherits FlowTextFieldBase
<div class="@FieldClasses" style="@Styles" data-size="@Size.ToString().ToLowerInvariant()">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="fui-field-label" for="@InputId">@Label@if (Required) { <span class="fui-required" aria-hidden="true"> *</span> }</label>
    }
    <textarea @attributes="AdditionalAttributes" @ref="InputElement" id="@InputId" class="fui-control"
              rows="@Rows" value="@Text" placeholder="@Placeholder" maxlength="@MaxLength"
              style="@TextAreaStyle" disabled="@Disabled" readonly="@ReadOnly"
              aria-required="@Required.ToString().ToLowerInvariant()" aria-invalid="@Invalid" aria-describedby="@DescriptionId"
              @oninput="HandleInput" @onchange="HandleChange" @onfocus="FocusAsync" @onblur="BlurAsync">@Text</textarea>
    <div class="fui-textarea-footer">
        @if (!string.IsNullOrEmpty(Message)) { <span id="@HelpId" class="fui-help @(HasErrors ? "fui-error" : "")">@Message</span> }
        @if (ShowCharacterCount) { <span class="fui-help fui-count">@(MaxLength is { } max ? $"{Text.Length} / {max}" : $"{Text.Length} characters")</span> }
    </div>
</div>
