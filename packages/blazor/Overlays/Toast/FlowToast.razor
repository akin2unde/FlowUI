@namespace FlowUI.Blazor.Overlays

@inherits FlowComponentBase
<div class="fui-toast-region" aria-live="polite" aria-atomic="true">
    @if (Open)
    {
        <div @attributes="AdditionalAttributes" id="@Id" class="@Classes("fui-toast")" style="@Styles" data-color="@Color.ToString().ToLowerInvariant()" role="status" @onmouseenter="Pause" @onmouseleave="Resume" @onfocusin="Pause" @onfocusout="Resume">
            <div>@if (!string.IsNullOrWhiteSpace(Title)) { <strong>@Title</strong> }@ChildContent</div>
            <button type="button" aria-label="Dismiss notification" @onclick="Dismiss">×</button>
        </div>
    }
</div>
