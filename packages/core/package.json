{
  "name": "@akin2unde/flowui-core",
  "version": "0.1.4",
  "description": "Framework-independent contracts, themes and style resolution for FlowUI.",
  "author": "Akintunde Morakinyo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akin2unde/FlowUI.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/akin2unde/FlowUI#readme",
  "bugs": "https://github.com/akin2unde/FlowUI/issues",
  "keywords": [
    "flowui",
    "ui",
    "tailwind",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "csstype": "^3.1.3"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "sideEffects": false
}
