@namespace FlowUI.Blazor.Presentation
@inherits FlowComponentBase

<span @attributes="AdditionalAttributes" id="@Id" class="@Classes("fui-loader")" style="@Styles"
      role="status" aria-label="@Label" data-size="@Size.ToString().ToLowerInvariant()">
    <span class="fui-spinner" aria-hidden="true"></span>
    @if (ShowLabel) { <span>@Label</span> }
</span>
