@namespace FlowUI.Blazor.Overlays

@inherits FlowComponentBase
<span @ref="anchor" @attributes="AdditionalAttributes" id="@Id" class="@Classes("fui-tooltip")" style="@Styles" data-location="@Location.ToLowerInvariant()" tabindex="0" aria-describedby="@tipId"
      @onmouseenter="Show" @onmouseleave="Hide" @onfocusin="Show" @onfocusout="Hide" @onkeydown="KeyDown">
    @ChildContent
    @if (visible) { <span role="tooltip" id="@tipId" class="fui-tip">@Text</span> }
</span>
