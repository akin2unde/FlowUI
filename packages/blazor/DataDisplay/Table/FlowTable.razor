@namespace FlowUI.Blazor.DataDisplay

@typeparam TItem
@inherits FlowComponentBase
<div @attributes="AdditionalAttributes" id="@Id" class="@Classes("fui-table-wrap")" style="@Styles" aria-busy="@Loading.ToString().ToLowerInvariant()">
@if (ColumnsConfigurable || Exportable)
{
    <div class="fui-table-tools">
        @if (ColumnsConfigurable)
        {
            <FlowMultiSelect TItem="FlowTableColumn<TItem>" TValue="string" Items="Columns" ValueSelector="ColumnKey"
                             TextSelector="column => column.Title" Values="SelectedColumns" ValuesChanged="ChangeColumns"
                             MaxVisibleTags="0" Placeholder="Columns" Label="Columns" />
        }
        @if (Exportable)
        {
            <button type="button" disabled="@(VisibleColumns.Count == 0)" @onclick="ExportCsv">Export CSV</button>
        }
    </div>
}
<div class="fui-table-scroll"><table><caption>@Caption</caption><thead><tr>
@foreach (var column in VisibleColumns) { <th scope="col" aria-sort="@(sortColumn == column ? descending ? "descending" : "ascending" : "none")">@if (column.Sortable) { <button type="button" @onclick="() => Sort(column)">@column.Title<span aria-hidden="true">@(sortColumn == column ? descending ? " ↓" : " ↑" : " ↕")</span></button> } else { @column.Title }</th> }
</tr></thead><tbody>
@if (Loading) { <tr><td colspan="@Math.Max(1, VisibleColumns.Count)" role="status">Loading rows…</td></tr> }
else if (Rows.Count == 0) { <tr><td colspan="@Math.Max(1, VisibleColumns.Count)">@EmptyText</td></tr> }
else { @foreach (var item in Rows) { <tr @key="RowKey is null ? (object)item! : RowKey(item)">@foreach (var column in VisibleColumns) { <td>@if (column.Template is not null) { @column.Template(item) } else { @column.Value(item) }</td> }</tr> } }
</tbody></table></div>
@if (LoadMoreTemplate is not null || OnLoadMore.HasDelegate)
{
    var context = LoadContext;
    @if (LoadMoreTemplate is not null) { @LoadMoreTemplate(context) }
    else
    {
        <div class="fui-load-more">
            <span role="status">@($"{context.LoadedCount}{(context.TotalCount is int count ? $" of {count}" : "")} records loaded")</span>
            @if (context.HasMore)
            {
                <button type="button" disabled="@context.Loading" @onclick="RequestMore">@(context.Loading ? "Loading…" : "Load more")</button>
            }
        </div>
    }
}

@if (PageSize > 0 && PageCount > 1) { <div class="fui-table-pages"><FlowPagination Page="Page" PageChanged="ChangePage" PageCount="PageCount" /></div> }
</div>
