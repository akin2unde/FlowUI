{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FlowUI Blazor Sample",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build FlowUI Blazor",
      "program": "${workspaceFolder}/examples/blazor/bin/Debug/net10.0/FlowUI.Blazor.Sample.dll",
      "args": [],
      "cwd": "${workspaceFolder}/examples/blazor",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5180"
      },
      "console": "internalConsole"
    }
  ]
}
