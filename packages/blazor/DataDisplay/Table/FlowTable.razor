@namespace FlowUI.Blazor.DataDisplay

@typeparam TItem
@inherits FlowComponentBase
<div @attributes="AdditionalAttributes" id="@Id" class="@Classes("fui-table-wrap")" style="@Styles" aria-busy="@Loading.ToString().ToLowerInvariant()">
<table><caption>@Caption</caption><thead><tr>
@foreach (var column in Columns) { <th scope="col" aria-sort="@(sortColumn == column ? descending ? "descending" : "ascending" : "none")">@if (column.Sortable) { <button type="button" @onclick="() => Sort(column)">@column.Title<span aria-hidden="true">@(sortColumn == column ? descending ? " ↓" : " ↑" : " ↕")</span></button> } else { @column.Title }</th> }
</tr></thead><tbody>
@if (Loading) { <tr><td colspan="@Math.Max(1, Columns.Count)" role="status">Loading rows…</td></tr> }
else if (Rows.Count == 0) { <tr><td colspan="@Math.Max(1, Columns.Count)">@EmptyText</td></tr> }
else { @foreach (var item in Rows) { <tr @key="RowKey is null ? (object)item! : RowKey(item)">@foreach (var column in Columns) { <td>@if (column.Template is not null) { @column.Template(item) } else { @column.Value(item) }</td> }</tr> } }
</tbody></table>
@if (PageSize > 0 && PageCount > 1) { <div class="fui-table-pages"><FlowPagination Page="Page" PageChanged="ChangePage" PageCount="PageCount" /></div> }
</div>
