<FlowVC Gap="1.5rem">
<DemoBlock Title="Accordion" Markup="@Example0" Code="@ExampleCode">
<FlowAccordion Items="questions" @bind-OpenKeys="openQuestions">
    <Content Context="key">@(key == "installation" ? "Install the package and import the FlowUI namespaces in _Imports.razor." : "Choose Light, Dark, or System and supply your own palette when needed.")</Content>
</FlowAccordion>
</DemoBlock>
<DemoBlock Title="Table" Markup="@Example1" Code="@ExampleCode">
<FlowTable TItem="Product" Items="@products.Take(loadedProducts).ToArray()" Columns="columns" RowKey="p => p.Id"
                   Caption="Product inventory" PageSize="0" ColumnsConfigurable="true" Exportable="true" TotalCount="@products.Length" OnLoadMore="LoadProducts">
            <LoadMoreTemplate Context="footer">
                <p role="status">@($"{footer.LoadedCount} of {footer.TotalCount} products loaded")</p>
                @if (footer.HasMore)
                {
                    <FlowButton Disabled="footer.Loading" OnClick="() => footer.LoadMore()">Show more products</FlowButton>
                }
            </LoadMoreTemplate>
        </FlowTable>
</DemoBlock>
<DemoBlock Title="Tree" Markup="@Example2" Code="@ExampleCode">
<FlowTree Items="nodes" ValueSelector="n => n.Id" TextSelector="n => n.Name" ChildrenSelector="n => n.Children"
          @bind-Value="selectedNode" @bind-ExpandedValues="expanded" Label="Project folders" />
<p role="status">Selected node: @(selectedNode ?? "none")</p>
</DemoBlock>
</FlowVC>
